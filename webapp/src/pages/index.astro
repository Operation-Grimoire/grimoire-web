---
import Layout from '../layouts/Layout.astro';
import { site } from '../site.config';
import Screenshots from '../components/Screenshots.astro';
import Features from '../components/Features.astro';
---

<Layout>
  <main class="flex min-h-[88vh] items-center justify-center px-6 py-20">
    <section class="max-w-2xl text-center">
      <img
        src="/favicon.svg"
        alt={`${site.brand} app icon`}
        width="128"
        height="128"
        class="mx-auto mb-8 h-28 w-28 sm:h-32 sm:w-32 rounded-3xl shadow-xl shadow-ink/40"
      />
      <h1 class="font-display text-7xl sm:text-8xl font-semibold text-vellum tracking-tight">
        {site.brand}
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-vellum-dim leading-relaxed">
        {site.tagline}
      </p>

      <div class="mt-12 flex flex-col sm:flex-row gap-4 items-center justify-center">
        <a
          href={site.android.latestApkUrl}
          class="inline-flex items-center gap-2 px-8 py-3 rounded-md bg-ember text-ink font-semibold hover:bg-ember-bright transition-colors shadow-lg shadow-ember/20"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download APK
        </a>
        <a
          href="/docs"
          class="inline-flex items-center gap-2 px-8 py-3 rounded-md border border-ember/60 text-ember font-semibold hover:bg-ember hover:text-ink transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          Documentation
        </a>
      </div>

      <p class="mt-8 text-sm text-vellum-dim/70">
        <a href={site.android.latestReleaseUrl} rel="noopener" class="hover:text-ember underline-offset-4 hover:underline">
          All releases
        </a>
        <span class="mx-2 text-rune">·</span>
        Open source on
        <a href={site.android.repoUrl} rel="noopener" class="text-arcane-bright hover:text-ember underline-offset-4 hover:underline">
          GitHub
        </a>
      </p>
    </section>
  </main>

  <Screenshots />
  <Features />
</Layout>
