---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { entryUrl } from '../../lib/docs';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => {
    // '/docs' -> undefined slug; '/docs/users/install' -> 'users/install'
    const slug = entryUrl(entry).replace(/^\/docs\/?/, '') || undefined;
    return { params: { slug }, props: { entry, docs } };
  });
}

const { entry, docs } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings} docs={docs}>
  <Content />
</DocsLayout>
