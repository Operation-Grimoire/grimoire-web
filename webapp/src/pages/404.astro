---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404" noindex={true}>
  <main id="main-content" class="min-h-[70vh] flex items-center justify-center px-6 py-20">
    <section class="max-w-md text-center">
      <p class="font-display text-9xl text-ember leading-none">404</p>
      <h1 class="mt-6 font-display text-3xl text-vellum">Page not found</h1>
      <p class="mt-4 text-vellum-dim">
        Check the address or return to the homepage.
      </p>
      <a
        href="/"
        class="mt-10 inline-flex items-center gap-2 px-6 py-3 rounded-md bg-ember text-ink font-semibold hover:bg-ember-bright transition-colors"
      >
        ← Return home
      </a>
    </section>
  </main>
</Layout>
