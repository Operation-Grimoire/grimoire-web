---
interface Props {
  /** Label shown to the left of the value. */
  label: string;
  /** id assigned to the value span so callers can populate it (e.g. from URL params). */
  targetId: string;
  /** Optional initial value; defaults to an em dash placeholder. */
  value?: string;
}

const { label, targetId, value = '—' } = Astro.props;
---

<div class="hs-tooltip [--placement:top] block">
  <button
    type="button"
    data-copy
    data-copy-target={targetId}
    data-copy-label={label}
    class="hs-tooltip-toggle copy-field group flex items-start gap-3 w-full text-left p-3 rounded border border-rune bg-ink hover:border-ember/60 transition-colors disabled:opacity-50 disabled:cursor-default disabled:hover:border-rune"
  >
    <span class="shrink-0 text-xs uppercase tracking-wide text-vellum-dim/70 pt-0.5 w-20">{label}</span>
    <span id={targetId} class="flex-1 font-mono text-sm text-vellum break-all">{value}</span>
    <span class="copy-icon shrink-0 text-vellum-dim/60 group-hover:text-ember transition-colors" aria-hidden="true">
      <svg class="copy-default" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z"/></svg>
      <svg class="copy-done hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 -960 960 960" fill="currentColor"><path d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z"/></svg>
    </span>
    <span class="copy-label sr-only" role="status" aria-live="polite"></span>
    <span
      class="hs-tooltip-content opacity-0 invisible transition-opacity absolute z-30 py-1 px-2 bg-ink-soft border border-rune rounded shadow-md text-xs font-medium text-vellum whitespace-nowrap"
      role="tooltip"
    >
      Click to copy
    </span>
  </button>
</div>

<script>
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Fallback for non-secure contexts / older browsers
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      document.body.removeChild(ta);
      return ok;
    }
  }

  const timers = new WeakMap<HTMLButtonElement, number>();

  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.getAttribute('data-copy-target');
      const value = targetId ? document.getElementById(targetId)?.textContent?.trim() : '';
      if (!value || value === '—') return;

      const ok = await copyText(value);

      const def = btn.querySelector('.copy-default');
      const done = btn.querySelector('.copy-done');
      const label = btn.querySelector('.copy-label');
      if (label) label.textContent = ok ? 'Copied' : 'Copy failed';

      if (ok) {
        def?.classList.add('hidden');
        done?.classList.remove('hidden');
        btn.classList.add('border-ember/60');

        document.dispatchEvent(
          new CustomEvent('copyfield:copied', {
            detail: { label: btn.getAttribute('data-copy-label') ?? 'Value' },
          })
        );

        const prev = timers.get(btn);
        if (prev) window.clearTimeout(prev);
        timers.set(
          btn,
          window.setTimeout(() => {
            def?.classList.remove('hidden');
            done?.classList.add('hidden');
            btn.classList.remove('border-ember/60');
            if (label) label.textContent = '';
          }, 1600)
        );
      }
    });
  });
</script>
