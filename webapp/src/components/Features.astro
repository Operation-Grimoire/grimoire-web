---
const features = [
  {
    title: 'Pluggable sources',
    body: 'Every source is a separate extension the app discovers at runtime — the catalogue grows without re-shipping the app. The official repo is enabled out of the box; add your own, even private GitHub repos.',
    icon: '<path d="M14 7h2a2 2 0 0 1 2 2v2"/><path d="M7 14H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h2"/><path d="M10 5a2 2 0 1 1 4 0v2h-4z"/><path d="M19 10a2 2 0 1 1 0 4h-2v-4z"/><rect x="7" y="7" width="7" height="7" rx="1"/>',
  },
  {
    title: 'A reader you control',
    body: 'Adjustable font, spacing, line height, colour theme and orientation. Image privacy mode, and optional text-to-speech with on-device or ElevenLabs voices.',
    icon: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  },
  {
    title: 'Organized library',
    body: 'Categories — including PIN-locked hidden ones — with per-category background refresh, custom sort, filter and search, plus EPUB import.',
    icon: '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>',
  },
  {
    title: 'Read offline',
    body: 'A foreground download service with a per-chapter image store keeps your novels available with no connection.',
    icon: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>',
  },
  {
    title: 'NovelUpdates built in',
    body: 'Cross-source metadata, rankings, latest releases and saved series — with “read this with one of your sources” matching.',
    icon: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  },
  {
    title: 'Yours to keep',
    body: 'Manual and scheduled local backups, source migration that preserves history, and an in-app updater that pulls signed releases from GitHub.',
    icon: '<path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"/><path d="M7 3v4a1 1 0 0 0 1 1h7"/>',
  },
];
---

<section class="mx-auto max-w-5xl px-6 py-20">
  <h2 class="text-center font-display text-4xl sm:text-5xl font-semibold text-vellum">
    Everything a long-form reader needs
  </h2>
  <p class="mx-auto mt-4 max-w-2xl text-center text-vellum-dim">
    Grimoire is an open-source, Compose-built Android reader designed for web novels and EPUBs.
  </p>

  <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((f) => (
        <div class="rounded-xl border border-rune bg-ink-soft/40 p-6 transition-colors hover:border-ember/50">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-ember/10 text-ember">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
          </span>
          <h3 class="mt-4 font-display text-xl text-vellum">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-vellum-dim">{f.body}</p>
        </div>
      ))
    }
  </div>
</section>
