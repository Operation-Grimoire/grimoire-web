---
import Icon from './Icon.astro';

const highlights = [
  {
    icon: 'headphones',
    title: 'Read or listen',
    description: 'Adjust fonts, colors, and spacing, or let your phone read chapters aloud.',
  },
  {
    icon: 'download',
    title: 'Take books offline',
    description: 'Download chapters or keep EPUBs on your phone to read without an internet connection.',
  },
  {
    icon: 'library',
    title: 'Keep your library organized',
    description: 'Group your books, resume where you stopped, and follow new chapter releases.',
  },
] as const;
---

<section id="overview" class="reading-overview page-width" aria-labelledby="overview-title">
  <div class="overview-intro">
    <h2 id="overview-title" data-ghost-heading>Books from websites and your own collection</h2>
    <p data-ghost-avoid>Read from supported novel websites or import your own EPUB books. Keep them together in one library.</p>
    <div class="overview-links" data-ghost-avoid>
      <a href="/docs/users/"><span>Get started</span><Icon name="arrow" size={18} /></a>
      <a href="#features"><span>Explore all features</span><Icon name="arrow" size={18} /></a>
    </div>
  </div>
  <ul class="overview-highlights" data-ghost-avoid>
    {highlights.map((highlight) => (
      <li>
        <Icon name={highlight.icon} size={25} />
        <div><h3>{highlight.title}</h3><p>{highlight.description}</p></div>
      </li>
    ))}
  </ul>
</section>

<style>
  .reading-overview { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 96px; padding-block: 96px; border-top: 1px solid var(--color-rune); scroll-margin-top: 24px; }
  h2 { max-width: 18ch; margin: 0; font: 400 clamp(2rem, 3.4vw, 2.9rem)/1.18 var(--font-display); letter-spacing: -0.02em; text-wrap: balance; overflow-wrap: anywhere; }
  p { margin: 16px 0 0; color: var(--color-vellum-dim); font-size: 17px; line-height: 1.75; }
  .overview-intro > p { max-width: 43ch; }
  .overview-links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; margin-top: 24px; }
  .overview-links a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--color-ember); font-size: 15px; text-decoration: none; }
  .overview-links span { text-decoration: underline dotted; text-decoration-thickness: 2px; text-decoration-color: #7393ad; text-underline-offset: 5px; }
  .overview-links a:hover, .overview-links a:focus-visible { color: var(--color-ember-bright); }
  .overview-links a:hover span, .overview-links a:focus-visible span { text-decoration-style: solid; text-decoration-color: var(--color-ember-bright); }
  .overview-highlights { display: flex; flex-direction: column; gap: 28px; list-style: none; margin: 0; padding: 0; }
  .overview-highlights li { display: grid; grid-template-columns: 25px minmax(0, 1fr); align-items: start; gap: 20px; padding-bottom: 28px; border-bottom: 1px solid var(--color-rune); }
  .overview-highlights li:last-child { border-bottom: 0; padding-bottom: 0; }
  .overview-highlights :global(svg) { margin-top: 5px; color: var(--color-ember); }
  h3 { margin: 0; font: 400 25px/1.3 var(--font-display); letter-spacing: -0.015em; }
  .overview-highlights p { margin-top: 8px; font-size: 16px; }
  @media (max-width: 1100px) { .reading-overview { gap: 48px; } }
  @media (max-width: 800px) {
    .reading-overview { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-block: 64px; }
    h2 { max-width: 22ch; }
    .overview-intro > p { max-width: 48ch; font-size: 16px; }
    .overview-highlights li { gap: 16px; }
    h3 { font-size: 24px; }
  }
</style>
