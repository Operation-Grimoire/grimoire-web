---
import { Image } from 'astro:assets';
import library from '../assets/screenshots/library.webp';
import browse from '../assets/screenshots/browse.webp';
import novelDetail from '../assets/screenshots/novel-detail.webp';
import reader from '../assets/screenshots/reader.webp';
import locked from '../assets/screenshots/webnovel-locked-chapters.webp';

const shots = [
  { src: library, label: 'Library' },
  { src: browse, label: 'Browse a source' },
  { src: novelDetail, label: 'Novel detail' },
  { src: reader, label: 'Reader' },
  { src: locked, label: 'Locked chapters' },
];
---

<section class="py-20">
  <div class="mx-auto max-w-5xl px-6 text-center">
    <h2 class="font-display text-4xl sm:text-5xl font-semibold text-vellum">See it in action</h2>
    <p class="mx-auto mt-4 max-w-2xl text-vellum-dim">
      A Material 3 interface built with Jetpack Compose — from your library to the page.
    </p>
  </div>

  <div class="relative mt-12">
    {/* Edge fades hint that the row scrolls. */}
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-10 bg-gradient-to-r from-ink to-transparent sm:w-16"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-10 bg-gradient-to-l from-ink to-transparent sm:w-16"></div>

    <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-6 px-6 pb-4 [-ms-overflow-style:none] [justify-content:safe_center] [scrollbar-width:none] sm:gap-6 [&::-webkit-scrollbar]:hidden">
      {
        shots.map((s) => (
          <figure class="shrink-0 snap-center">
            <div class="overflow-hidden rounded-[1.5rem] border border-rune bg-ink-soft shadow-xl shadow-ink/50 sm:rounded-[1.75rem]">
              <Image
                src={s.src}
                alt={`${s.label} screen`}
                width={240}
                densities={[2]}
                loading="lazy"
                class="block h-auto w-[150px] sm:w-[185px] lg:w-[210px]"
              />
            </div>
            <figcaption class="mt-3 text-center text-xs text-vellum-dim sm:text-sm">{s.label}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
