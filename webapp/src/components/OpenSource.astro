---
import Icon from './Icon.astro';
import { site } from '../site.config';
---

<section id="open-source" class="open-source page-width" aria-labelledby="open-source-title">
  <div class="project-copy" data-ghost-avoid>
    <h2 id="open-source-title">Open source</h2>
    <p>Grimoire's code is public on GitHub. Read how it works, report a problem, or help improve the app and its website add-ons.</p>
  </div>
  <nav class="project-links" aria-label="Open source links" data-ghost-avoid>
    <a href={site.android.repoUrl}><span>View the code</span><Icon name="external" size={18} /></a>
    <a href={`${site.android.repoUrl}/issues`}><span>Report a problem</span><Icon name="external" size={18} /></a>
    <a href="/docs/development/"><span>Contribute to Grimoire</span><Icon name="arrow" size={18} /></a>
  </nav>
</section>

<style>
  .open-source { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); align-items: center; gap: 96px; padding-block: 80px; border-top: 1px solid var(--color-rune); }
  h2 { margin: 0; font: 400 clamp(2rem, 3.4vw, 2.9rem)/1.2 var(--font-display); letter-spacing: -0.02em; }
  p { max-width: 55ch; margin: 16px 0 0; color: var(--color-vellum-dim); font-size: 17px; line-height: 1.75; }
  .project-links { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; max-width: 100%; color: var(--color-ember); font-size: 16px; text-decoration: none; }
  a span { min-width: 0; text-decoration: underline dotted #7393ad; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  a :global(svg) { flex-shrink: 0; }
  a:hover, a:focus-visible { color: var(--color-ember-bright); }
  a:hover span, a:focus-visible span { text-decoration-style: solid; text-decoration-color: var(--color-ember-bright); }
  @media (max-width: 1100px) { .open-source { gap: 48px; } }
  @media (max-width: 800px) { .open-source { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-block: 64px; }p { font-size: 16px; } }
</style>
